{
  "$schema": "https://railway.app/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "corepack pnpm install --frozen-lockfile && corepack pnpm build" },
  "deploy": {
    "startCommand": "corepack pnpm start",
